{
  "expo": {
    "name": "Driveby Africa",
    "slug": "drivebyafrica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "drivebyafrica",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo-dark.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drivebyafrica.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F14"
      },
      "package": "com.drivebyafrica.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f11c9f13-beef-4848-adce-dc72539f36bf"
      }
    },
    "owner": "florentfranck"
  }
}
